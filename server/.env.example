# cp .env.example .env, then edit. Every value here is optional; the defaults
# in compose.yml are what you get without a .env at all.

# Host interface to publish on. Loopback unless something terminates TLS in
# front of this - a proxy, a tunnel. 0.0.0.0 puts plain HTTP on the internet.
BIND_ADDR=127.0.0.1

# Host port. The container always listens on 8888 internally.
HOST_PORT=8888

# Concurrent connections. Worst-case memory is this times 128 KB.
OOO_MAX_CONNECTIONS=512

# Container memory ceiling. Wants headroom over the worst case above.
MEM_LIMIT=96m

# File descriptor limit. Must stay above OOO_MAX_CONNECTIONS.
NOFILE=4096
